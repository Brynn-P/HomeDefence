# ============================================================
# HomeDefence — .gitignore
# ============================================================

# ------------------------------------------------------------
# SECRETS — never commit these
# ------------------------------------------------------------
cord.env
*.env
.env.*
secrets/
*webhook*
*apikey*

# ------------------------------------------------------------
# LOGS — generated at runtime, can be large
# ------------------------------------------------------------
logs/
*.log
*.log.*

# ------------------------------------------------------------
# SCAN DATA — CSV output from scans
# ------------------------------------------------------------
*.csv

# ------------------------------------------------------------
# MOTION IMAGES — can get very large over time
# ------------------------------------------------------------
images/
*.jpg
*.jpeg
*.png

# ------------------------------------------------------------
# GENERATED CONFIG STUBS — users create their own
# (uncomment these lines if you want to ship blank templates
#  instead of letting the scripts auto-generate them)
# ------------------------------------------------------------
# config/known_devices.json
# config/known_wifi.json
# config/known_bluetooth.json

# ------------------------------------------------------------
# RUNTIME / TEMP FILES
# ------------------------------------------------------------
/tmp/
*.tmp
*.bak
*.old
*.lock
*.pid
homewatch_last_motion_scan
device_log.csv.old

# ------------------------------------------------------------
# PYTHON
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
*.whl
*.spec
.installed.cfg

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter notebooks (if used for analysis)
.ipynb_checkpoints/

# ------------------------------------------------------------
# EDITORS & IDEs
# ------------------------------------------------------------

# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Windows (if ever edited on Windows)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# RASPBERRY PI SPECIFIC
# ------------------------------------------------------------
# Pi camera tuning files
*.tuning.json

# systemd override files (machine-specific)
*.service.d/

# ------------------------------------------------------------
# MISC
# ------------------------------------------------------------
*.zip
*.tar.gz
*.tar.bz2
*.rar
